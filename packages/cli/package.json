{
  "name": "@reins/cli",
  "version": "0.1.0",
  "description": "The reins command line: init, status, check, record, decide, ledger, evidence, proxy and dashboard",
  "license": "MIT",
  "type": "module",
  "bin": { "reins": "./dist/main.js" },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
